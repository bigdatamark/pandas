# [MODULE DOC]
# Tempita template for a centered interval tree, included at the end of
# interval.pyx. IntervalTree (the public object, mimicking the IndexEngine API for
# IntervalIndex) holds left/right bound arrays and a root node. Nodes are generated
# for every combination of dtype (float64, int64, uint64) and closed side
# (left/right/both/neither), giving classes <Dtype>Closed<Side>IntervalNode with the
# endpoint comparisons (< or <=) baked in; NODE_CLASSES maps (dtype string, closed)
# to the class. Each non-leaf node picks a pivot (median of interval midpoints),
# sends intervals entirely left/right of it to child nodes and keeps the
# intervals containing the pivot in two sorted "center" lists (by left bound and by
# right bound) so point queries can stop early. Leaves (size <= leaf_size) are
# scanned linearly. Fused types int_scalar_t/uint_scalar_t/scalar_t allow query
# points of int64/uint64/float64.
"""
Template for intervaltree

WARNING: DO NOT edit .pxi FILE directly, .pxi is generated from .pxi.in
"""

from pandas._libs.algos import is_monotonic

ctypedef fused int_scalar_t:
    int64_t
    float64_t

ctypedef fused uint_scalar_t:
    uint64_t
    float64_t

ctypedef fused scalar_t:
    int_scalar_t
    uint_scalar_t

# ----------------------------------------------------------------------
# IntervalTree
# ----------------------------------------------------------------------

cdef class IntervalTree(IntervalMixin):
    # [CLASS DOC]
    # Centered interval tree over a set of intervals with a common closed side.
    # Read-only attributes: left/right - bound arrays (NaN-left intervals removed);
    # root - top IntervalNode; dtype - common numpy dtype of bounds; closed - side;
    # _is_overlapping/_left_sorter/_right_sorter - lazily computed caches (None until
    # computed); _na_count - number of intervals dropped because their left was NaN.
    """A centered interval tree

    Based off the algorithm described on Wikipedia:
    https://en.wikipedia.org/wiki/Interval_tree

    we are emulating the IndexEngine interface
    """
    cdef readonly:
        ndarray left, right
        IntervalNode root
        object dtype
        str closed
        object _is_overlapping, _left_sorter, _right_sorter
        Py_ssize_t _na_count

    def __init__(self, left, right, closed='right', leaf_size=100):
        # [FUNCTION DOC]
        # Build the tree.
        # Inputs: left, right - 1-D array-likes of bounds (same length); closed - side
        # string (default "right"); leaf_size - maximum node size for linear scanning.
        # Outputs: none.
        # Exceptions: ValueError for an invalid closed; KeyError if the resulting dtype/
        # closed pair has no node class (e.g. a non-numeric dtype); TypeError from isnan
        # for unsupported dtypes.
        # Side effects: converts bounds to their common result dtype, drops entries
        #   whose
        # left bound is NaN (recording the count), builds int64 original-position
        #   indices
        # for the kept entries and constructs the root node recursively (allocations).
        # Note: only NaN in left is checked; an interval with NaN right but non-
        #   NaN
        # left would be kept in the tree.
        """
        Parameters
        ----------
        left, right : np.ndarray[ndim=1]
            Left and right bounds for each interval. Assumed to contain no
            NaNs.
        closed : {'left', 'right', 'both', 'neither'}, optional
            Whether the intervals are closed on the left-side, right-side, both
            or neither. Defaults to 'right'.
        leaf_size : int, optional
            Parameter that controls when the tree switches from creating nodes
            to brute-force search. Tune this parameter to optimize query
            performance.
        """
        if closed not in ['left', 'right', 'both', 'neither']:
            raise ValueError("invalid option for 'closed': %s" % closed)

        left = np.asarray(left)
        right = np.asarray(right)
        self.dtype = np.result_type(left, right)
        self.left = np.asarray(left, dtype=self.dtype)
        self.right = np.asarray(right, dtype=self.dtype)

        indices = np.arange(len(left), dtype='int64')

        self.closed = closed

        # GH 23352: ensure no nan in nodes
        mask = ~np.isnan(self.left)
        self._na_count = len(mask) - mask.sum()
        self.left = self.left[mask]
        self.right = self.right[mask]
        indices = indices[mask]

        node_cls = NODE_CLASSES[str(self.dtype), closed]
        self.root = node_cls(self.left, self.right, indices, leaf_size)

    @property
    def left_sorter(self) -> np.ndarray:
        # [FUNCTION DOC]
        # Property: permutation sorting intervals by left bound, ties broken by right
        #   bound
        # (lexicographic sort with left as primary key). Cached after first computation.
        # Outputs: integer ndarray of positions.
        """How to sort the left labels; this is used for binary search
        """
        if self._left_sorter is None:
            values = [self.right, self.left]
            self._left_sorter = np.lexsort(values)
        return self._left_sorter

    @property
    def right_sorter(self) -> np.ndarray:
        # [FUNCTION DOC]
        # Property: argsort of the right bounds (cached after first computation).
        # Outputs: integer ndarray of positions.
        """How to sort the right labels
        """
        if self._right_sorter is None:
            self._right_sorter = np.argsort(self.right)
        return self._right_sorter

    @property
    def is_overlapping(self) -> bool:
        # [FUNCTION DOC]
        # Property: whether any two intervals overlap. Cached.
        # Outputs: bool. Using left_sorter order, compares each interval's left with the
        # previous interval's right: overlap if current left < previous right (<= when
        # closed is "both").
        # Note: checking adjacent pairs suffices, since any overlapping pair implies
        #   an overlapping adjacent pair in left-sorted order.
        """
        Determine if the IntervalTree contains overlapping intervals.
        Cached as self._is_overlapping.
        """
        if self._is_overlapping is not None:
            return self._is_overlapping

        # <= when both sides closed since endpoints can overlap
        op = le if self.closed == 'both' else lt

        # overlap if start of current interval < end of previous interval
        # (current and previous in terms of sorted order by left/start side)
        current = self.left[self.left_sorter[1:]]
        previous = self.right[self.left_sorter[:-1]]
        self._is_overlapping = bool(op(current, previous).any())

        return self._is_overlapping

    @property
    def is_monotonic_increasing(self) -> bool:
        # [FUNCTION DOC]
        # Property: whether the intervals are monotonic increasing.
        # Outputs: False if any NaN intervals were dropped; otherwise True if
        #   left_sorter
        # is itself monotonic increasing, i.e. the intervals are already in sorted
        # (left, then right) order.
        """
        Return True if the IntervalTree is monotonic increasing (only equal or
        increasing values), else False
        """
        if self._na_count > 0:
            return False

        sort_order = self.left_sorter
        return is_monotonic(sort_order, False)[0]

    def get_indexer(self, ndarray[scalar_t, ndim=1] target) -> np.ndarray:
        # [FUNCTION DOC]
        # Map each target point to the unique interval containing it.
        # Inputs: target - 1-D array of int64/uint64/float64 points (fused type).
        # Outputs: intp array, one entry per target: position of the containing interval
        # in the original input, or -1 if none (also for NaN or overflowing points).
        # Exceptions: KeyError if a point lies in more than one interval.
        # Side effects: allocates a growable int64 vector.
        """Return the positions corresponding to unique intervals that overlap
        with the given array of scalar targets.
        """

        # TODO: write get_indexer_intervals
        cdef:
            Py_ssize_t old_len
            Py_ssize_t i
            Int64Vector result

        result = Int64Vector()
        old_len = 0
        for i in range(len(target)):
            try:
                self.root.query(result, target[i])
            except OverflowError:
                # overflow -> no match, which is already handled below
                pass

            if result.data.size == old_len:
                result.append(-1)
            elif result.data.size > old_len + 1:
                raise KeyError(
                    'indexer does not intersect a unique set of intervals')
            old_len = result.data.size
        return result.to_array().astype('intp')

    def get_indexer_non_unique(self, ndarray[scalar_t, ndim=1] target):
        # [FUNCTION DOC]
        # Map each target point to all intervals containing it.
        # Inputs: target - 1-D array of int64/uint64/float64 points.
        # Outputs: tuple (indexer, missing) of intp arrays: indexer concatenates, per
        # target in order, the original positions of all matching intervals (or -1 if no
        # match); missing holds target positions that had no match.
        # Side effects: allocates growable vectors.
        """Return the positions corresponding to intervals that overlap with
        the given array of scalar targets. Non-unique positions are repeated.
        """
        cdef:
            Py_ssize_t old_len
            Py_ssize_t i
            Int64Vector result, missing

        result = Int64Vector()
        missing = Int64Vector()
        old_len = 0
        for i in range(len(target)):
            try:
                self.root.query(result, target[i])
            except OverflowError:
                # overflow -> no match, which is already handled below
                pass

            if result.data.size == old_len:
                result.append(-1)
                missing.append(i)
            old_len = result.data.size
        return (result.to_array().astype('intp'),
                missing.to_array().astype('intp'))

    def __repr__(self) -> str:
        # [FUNCTION DOC]
        # Representation "<IntervalTree[dtype,closed]: N elements>" with N the number of
        # non-NaN intervals in the root.
        return ('<IntervalTree[{dtype},{closed}]: '
                '{n_elements} elements>'.format(
                    dtype=self.dtype, closed=self.closed,
                    n_elements=self.root.n_elements))

    # compat with IndexEngine interface
    def clear_mapping(self) -> None:
        # [FUNCTION DOC]
        # No-op kept for compatibility with the IndexEngine interface.
        pass


cdef take(ndarray source, ndarray indices):
    # [FUNCTION DOC]
    # HELPER: Take elements of a 1-D array at the given positions (axis 0).
    # Inputs: source - ndarray; indices - integer ndarray.
    # Outputs: new ndarray. Exceptions: IndexError for out-of-range positions.
    """Take the given positions from a 1D ndarray
    """
    return PyArray_Take(source, indices, 0)


cdef sort_values_and_indices(all_values, all_indices, subset):
    # [FUNCTION DOC]
    # HELPER: Restrict values/indices to a subset and sort them by value.
    # Inputs: all_values - bound array; all_indices - int64 original positions;
    # subset - positions to select.
    # Outputs: tuple (sorted_values, sorted_indices) ordered by value (quicksort, not
    # stable).
    indices = take(all_indices, subset)
    values = take(all_values, subset)
    sorter = PyArray_ArgSort(values, 0, NPY_QUICKSORT)
    sorted_values = take(values, sorter)
    sorted_indices = take(indices, sorter)
    return sorted_values, sorted_indices


# ----------------------------------------------------------------------
# Nodes
# ----------------------------------------------------------------------

@cython.internal
cdef class IntervalNode:
    # [CLASS DOC]
    # Abstract base for tree nodes (internal, not importable). Read-only fields:
    # n_elements - number of intervals under the node; n_center - number stored at
    # this node's center (0 for leaves); leaf_size - threshold; is_leaf_node.
    cdef readonly:
        int64_t n_elements, n_center, leaf_size
        bint is_leaf_node

    def __repr__(self) -> str:
        # [FUNCTION DOC]
        # Representation. Leaf: "<Class: N elements (terminal)>". Non-leaf: includes
        #   pivot,
        # element count and the counts in left child, right child and center.
        if self.is_leaf_node:
            return (
                f"<{type(self).__name__}: {self.n_elements} elements (terminal)>"
            )
        else:
            n_left = self.left_node.n_elements
            n_right = self.right_node.n_elements
            n_center = self.n_elements - n_left - n_right
            return (
                f"<{type(self).__name__}: "
                f"pivot {self.pivot}, {self.n_elements} elements "
                f"({n_left} left, {n_right} right, {n_center} overlapping)>"
            )

    def counts(self):
        # [FUNCTION DOC]
        # Debug helper returning node counts.
        # Outputs: for leaves, n_elements; otherwise a nested tuple (center count,
        # (left child counts, right child counts)).
        """
        Inspect counts on this node
        useful for debugging purposes
        """
        if self.is_leaf_node:
            return self.n_elements
        else:
            m = len(self.center_left_values)
            l = self.left_node.counts()
            r = self.right_node.counts()
            return (m, (l, r))


# we need specialized nodes and leaves to optimize for different dtype and
# closed values

{{py:

nodes = []
for dtype in ['float64', 'int64', 'uint64']:
    for closed, cmp_left, cmp_right in [
        ('left', '<=', '<'),
        ('right', '<', '<='),
        ('both', '<=', '<='),
        ('neither', '<', '<')]:
        cmp_left_converse = '<' if cmp_left == '<=' else '<='
        cmp_right_converse = '<' if cmp_right == '<=' else '<='
        if dtype.startswith('int'):
            fused_prefix = 'int_'
        elif dtype.startswith('uint'):
            fused_prefix = 'uint_'
        elif dtype.startswith('float'):
            fused_prefix = ''
        nodes.append((dtype, dtype.title(),
                      closed, closed.title(),
                      cmp_left,
                      cmp_right,
                      cmp_left_converse,
                      cmp_right_converse,
                      fused_prefix))

}}

NODE_CLASSES = {}

{{for dtype, dtype_title, closed, closed_title, cmp_left, cmp_right,
      cmp_left_converse, cmp_right_converse, fused_prefix in nodes}}


@cython.internal
cdef class {{dtype_title}}Closed{{closed_title}}IntervalNode(IntervalNode):
    # [CLASS DOC]
    # Generated node class for one dtype and closed side. Template substitutes dtype
    # (float64/int64/uint64), closed side, and comparison operators: cmp_left is <= if
    # closed on the left else <; cmp_right is <= if closed on the right else <; the
    # converses are the opposite strictness. Fields: left_node/right_node children;
    # center_left_values/indices (center intervals sorted by left bound),
    # center_right_values/indices (sorted by right bound); left/right/indices (leaf
    # storage only); min_left/max_right (bounds over the whole subtree, 0 if empty);
    # pivot.
    """Non-terminal node for an IntervalTree

    Categorizes intervals by those that fall to the left, those that fall to
    the right, and those that overlap with the pivot.
    """
    cdef readonly:
        {{dtype_title}}Closed{{closed_title}}IntervalNode left_node, right_node
        {{dtype}}_t[:] center_left_values, center_right_values, left, right
        int64_t[:] center_left_indices, center_right_indices, indices
        {{dtype}}_t min_left, max_right
        {{dtype}}_t pivot

    def __init__(self,
                 ndarray[{{dtype}}_t, ndim=1] left,
                 ndarray[{{dtype}}_t, ndim=1] right,
                 ndarray[int64_t, ndim=1] indices,
                 int64_t leaf_size):
        # [FUNCTION DOC]
        # Build a node (recursively builds children).
        # Template: dtype substituted for bound arrays.
        # Inputs: left, right - bound arrays of the node's dtype; indices - int64
        #   original
        # positions; leaf_size - threshold.
        # Outputs: none.
        # Side effects: if n_elements <= leaf_size, stores arrays and becomes a leaf.
        # Otherwise computes pivot = median of (left/2 + right/2); if that is infinite,
        # uses 0 clamped into [min(left), max(right)]; classifies intervals, builds left
        # and right children from the subsets, and stores center intervals sorted by
        #   left
        # and by right bound. Records min_left/max_right for pruning.

        self.n_elements = len(left)
        self.leaf_size = leaf_size

        # min_left and min_right are used to speed-up query by skipping
        # query on sub-nodes. If this node has size 0, query is cheap,
        # so these values don't matter.
        if left.size > 0:
            self.min_left = left.min()
            self.max_right = right.max()
        else:
            self.min_left = 0
            self.max_right = 0

        if self.n_elements <= leaf_size:
            # make this a terminal (leaf) node
            self.is_leaf_node = True
            self.left = left
            self.right = right
            self.indices = indices
            self.n_center = 0
        else:
            # calculate a pivot so we can create child nodes
            self.is_leaf_node = False
            self.pivot = np.median(left / 2 + right / 2)
            if np.isinf(self.pivot):
                self.pivot = cython.cast({{dtype}}_t, 0)
                if self.pivot > np.max(right):
                    self.pivot = np.max(left)
                if self.pivot < np.min(left):
                    self.pivot = np.min(right)

            left_set, right_set, center_set = self.classify_intervals(
                left, right)

            self.left_node = self.new_child_node(left, right,
                                                 indices, left_set)
            self.right_node = self.new_child_node(left, right,
                                                  indices, right_set)

            self.center_left_values, self.center_left_indices = \
                sort_values_and_indices(left, indices, center_set)
            self.center_right_values, self.center_right_indices = \
                sort_values_and_indices(right, indices, center_set)
            self.n_center = len(self.center_left_indices)

    @cython.wraparound(False)
    @cython.boundscheck(False)
    cdef classify_intervals(self, {{dtype}}_t[:] left, {{dtype}}_t[:] right):
        # [FUNCTION DOC]
        # HELPER: Partition intervals relative to the pivot.
        # Template: comparisons use the converse operators for the closed side.
        # Inputs: left, right - bound memoryviews of length n_elements.
        # Outputs: tuple of three int64 arrays of positions: intervals entirely left of
        #   the
        # pivot (right bound does not reach pivot under the closed rule), entirely right
        # (left bound beyond pivot), and those containing the pivot.
        # Side effects: bounds/wraparound checks disabled.
        """Classify the given intervals based upon whether they fall to the
        left, right, or overlap with this node's pivot.
        """
        cdef:
            Int64Vector left_ind, right_ind, overlapping_ind
            Py_ssize_t i

        left_ind = Int64Vector()
        right_ind = Int64Vector()
        overlapping_ind = Int64Vector()

        for i in range(self.n_elements):
            if right[i] {{cmp_right_converse}} self.pivot:
                left_ind.append(i)
            elif self.pivot {{cmp_left_converse}} left[i]:
                right_ind.append(i)
            else:
                overlapping_ind.append(i)

        return (left_ind.to_array(),
                right_ind.to_array(),
                overlapping_ind.to_array())

    cdef new_child_node(self,
                        ndarray[{{dtype}}_t, ndim=1] left,
                        ndarray[{{dtype}}_t, ndim=1] right,
                        ndarray[int64_t, ndim=1] indices,
                        ndarray[int64_t, ndim=1] subset):
        # [FUNCTION DOC]
        # HELPER: Build a child node of the same class from a subset of intervals.
        # Inputs: left, right, indices - node arrays; subset - int64 positions to keep.
        # Outputs: new node built with the same leaf_size.
        """Create a new child node.
        """
        left = take(left, subset)
        right = take(right, subset)
        indices = take(indices, subset)
        return {{dtype_title}}Closed{{closed_title}}IntervalNode(
            left, right, indices, self.leaf_size)

    @cython.wraparound(False)
    @cython.boundscheck(False)
    @cython.initializedcheck(False)
    cpdef query(self, Int64Vector result, {{fused_prefix}}scalar_t point):
        # [FUNCTION DOC]
        # Append the original positions of all intervals containing point to result.
        # Template: comparisons use cmp_left/cmp_right for the closed side; point type
        #   is
        # the fused scalar for the dtype (int or uint variants plus float64).
        # Inputs: result - Int64Vector accumulator; point - scalar.
        # Outputs: none.
        # Side effects: mutates result. NaN points return immediately without matches.
        # Leaf: linear scan testing left cmp_left point cmp_right right. Non-leaf: if
        #   point
        # < pivot, scan center intervals by increasing left bound until left no longer
        # precedes point, then recurse left if point precedes left child's max_right; if
        # point > pivot, scan center intervals by decreasing right bound until point no
        # longer precedes right, then recurse right if right child's min_left precedes
        # point; if point equals pivot, all center intervals match.
        # Exceptions: OverflowError when point cannot be converted to the node dtype
        # (handled by callers).
        """Recursively query this node and its sub-nodes for intervals that
        overlap with the query point.
        """

        # GH 51826: ensures nan is handled properly during reindexing
        if np.isnan(point):
            return

        cdef:
            int64_t[:] indices
            {{dtype}}_t[:] values
            Py_ssize_t i

        if self.is_leaf_node:
            # Once we get down to a certain size, it doesn't make sense to
            # continue the binary tree structure. Instead, we use linear
            # search.
            for i in range(self.n_elements):
                if self.left[i] {{cmp_left}} point {{cmp_right}} self.right[i]:
                    result.append(self.indices[i])
        else:
            # There are child nodes. Based on comparing our query to the pivot,
            # look at the center values, then go to the relevant child.
            if point < self.pivot:
                values = self.center_left_values
                indices = self.center_left_indices
                for i in range(self.n_center):
                    if not values[i] {{cmp_left}} point:
                        break
                    result.append(indices[i])
                if point {{cmp_right}} self.left_node.max_right:
                    self.left_node.query(result, point)
            elif point > self.pivot:
                values = self.center_right_values
                indices = self.center_right_indices
                for i in range(self.n_center - 1, -1, -1):
                    if not point {{cmp_right}} values[i]:
                        break
                    result.append(indices[i])
                if self.right_node.min_left {{cmp_left}} point:
                    self.right_node.query(result, point)
            else:
                result.extend(self.center_left_indices)


NODE_CLASSES['{{dtype}}',
             '{{closed}}'] = {{dtype_title}}Closed{{closed_title}}IntervalNode

{{endfor}}
