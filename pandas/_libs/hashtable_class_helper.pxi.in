# Vector
# ----------------------------------------------------------------------

cdef class Vector:
    # [CLASS DOC]
    # Base of all Vector classes. external_view_exists (declared in hashtable.pxd)
    # becomes true once to_array has returned the internal buffer; growth afterwards
    # would invalidate that array, so it is refused with ValueError.
    # cdef readonly:
    #    bint external_view_exists

    def __cinit__(self):
        # [FUNCTION DOC]
        # Initialise external_view_exists to False. No inputs/outputs.
        self.external_view_exists = False


{{py:

# name, dtype, c_type
dtypes = [('Complex128', 'complex128', 'khcomplex128_t'),
          ('Complex64', 'complex64', 'khcomplex64_t'),
          ('Float64', 'float64', 'float64_t'),
          ('UInt64', 'uint64', 'uint64_t'),
          ('Int64', 'int64', 'int64_t'),
          ('Float32', 'float32', 'float32_t'),
          ('UInt32', 'uint32', 'uint32_t'),
          ('Int32', 'int32', 'int32_t'),
          ('UInt16', 'uint16', 'uint16_t'),
          ('Int16', 'int16', 'int16_t'),
          ('UInt8', 'uint8', 'uint8_t'),
          ('Int8', 'int8', 'int8_t')]

}}

{{for name, dtype, c_type in dtypes}}

cdef class {{name}}Vector(Vector):
    # [CLASS DOC]
    # Template, one class per numeric dtype (Complex128 ... Int8): growable array of
    # the substituted C type, backed by a numpy array ao of that dtype; data holds
    # the raw pointer into ao plus size and capacity. Int64Vector's fields are
    # declared in hashtable.pxd so other modules can use it.

    # For int64 we have to put this declaration in the .pxd file;
    # Int64Vector is the only one we need exposed for other cython files.
    {{if dtype != 'int64'}}
    cdef:
        {{name}}VectorData data
        ndarray ao
    {{endif}}

    def __cinit__(self):
        # [FUNCTION DOC]
        # Allocate the backing ndarray with the initial capacity (128) and point
        # data.data at it; size = 0. Side effects: allocates memory.
        self.data.size = 0
        self.data.capacity = _INIT_VEC_CAP
        self.ao = np.empty(self.data.capacity, dtype=np.{{dtype}})
        self.data.data = <{{c_type}}*>self.ao.data

    cdef resize(self, Py_ssize_t new_size):
        # [FUNCTION DOC]
        # HELPER: Set capacity to max(new_size, 128), resize the backing ndarray in
        # place (refcheck disabled, so existing views are NOT detected here) and refresh
        # the raw pointer. Inputs: new_size - requested element count. Side effects:
        # reallocation; callers must check external_view_exists first.
        self.data.capacity = max(new_size, _INIT_VEC_CAP)
        self.ao.resize(self.data.capacity, refcheck=False)
        self.data.data = <{{c_type}}*>self.ao.data

    def __len__(self) -> int:
        # [FUNCTION DOC]
        # Return the number of stored elements (data.size).
        return self.data.size

    cpdef ndarray to_array(self):
        # [FUNCTION DOC]
        # Return the stored elements as a 1-D ndarray of the vector's dtype without
        # copying: if capacity exceeds size the backing array is first shrunk to size.
        # Marks external_view_exists = True, so later growth raises.
        # Outputs: the internal ndarray (shares memory with the vector).
        # Exceptions: ValueError if shrinking is needed while a view already exists.
        if self.data.capacity != self.data.size:
            if self.external_view_exists:
                # should never happen
                raise ValueError("should have raised on append()")
            self.ao.resize(self.data.size, refcheck=False)
            self.data.capacity = self.data.size
        self.external_view_exists = True
        return self.ao

    cdef void append(self, {{c_type}} x) noexcept:
        # [FUNCTION DOC]
        # Append one element, growing capacity 4x when the buffer is full.
        # Inputs: x - element of the substituted C type.
        # Exceptions: ValueError if growth is needed while an external view exists.
        # KNOWN ISSUE: the method is declared noexcept, so that ValueError cannot
        # propagate; Cython prints it as unraisable and the element is silently dropped.
        # Side effects: mutates the buffer; may reallocate.

        if needs_resize(self.data.size, self.data.capacity):
            if self.external_view_exists:
                raise ValueError("external reference but "
                                 "Vector.resize() needed")
            self.resize(self.data.capacity * 4)

        append_data_{{dtype}}(&self.data, x)

    cdef extend(self, const {{c_type}}[:] x):
        # [FUNCTION DOC]
        # Append all elements of the 1-D memoryview x via a single memory copy; if the
        # result would not fit, grow to exactly size + len(x) (min 128).
        # Inputs: x - read-only 1-D memoryview of the substituted C type (contiguous
        # data assumed by the copy). Outputs: None.
        # Exceptions: ValueError if growth is needed while an external view exists.
        # Side effects: mutates the buffer.
        cdef Py_ssize_t x_size = len(x)
        if x_size == 0:
            return

        cdef Py_ssize_t needed_size = self.data.size + x_size
        if needs_resize(needed_size, self.data.capacity):
            if self.external_view_exists:
                raise ValueError("external reference but "
                                 "Vector.resize() needed")
            self.resize(needed_size)

        memcpy(self.data.data + self.data.size, &x[0], x_size * sizeof({{c_type}}))
        self.data.size = needed_size

{{endfor}}

cdef class StringVector(Vector):
    # [CLASS DOC]
    # Growable array of C string (char pointer) values in a malloc'ed buffer. It is
    # generated for completeness; ObjectVector is what the hash tables use. Pointers
    # are borrowed: the strings they point to must outlive the vector.

    cdef:
        StringVectorData data

    def __cinit__(self):
        # [FUNCTION DOC]
        # Allocate a pointer buffer of initial capacity 128; size = 0.
        # Exceptions: MemoryError if malloc fails. Side effects: heap allocation.
        self.data.size = 0
        self.data.capacity = _INIT_VEC_CAP
        self.data.data = <char **>malloc(self.data.capacity * sizeof(char *))
        if self.data.data is NULL:
            raise MemoryError()

    cdef resize(self, Py_ssize_t new_size):
        # [FUNCTION DOC]
        # HELPER: Grow the pointer buffer: new capacity is max(4 * old capacity, 128)
        # (new_size is ignored); allocate a new buffer and copy the old pointers.
        # Exceptions: MemoryError if malloc fails.
        # KNOWN ISSUE: the old buffer (orig_data) is never freed, leaking memory on
        # every
        # resize; also new_size is ignored and external_view_exists is not checked.
        cdef:
            char **orig_data
            Py_ssize_t i, orig_capacity

        orig_capacity = self.data.capacity
        self.data.capacity = max(self.data.capacity * 4, _INIT_VEC_CAP)

        orig_data = self.data.data
        self.data.data = <char **>malloc(self.data.capacity * sizeof(char *))
        if self.data.data is NULL:
            raise MemoryError()
        for i in range(orig_capacity):
            self.data.data[i] = orig_data[i]

    def __dealloc__(self):
        # [FUNCTION DOC]
        # Free the pointer buffer (not the strings it points to).
        free(self.data.data)

    def __len__(self) -> int:
        # [FUNCTION DOC]
        # Return the number of stored strings (data.size).
        return self.data.size

    cpdef ndarray[object, ndim=1] to_array(self):
        # [FUNCTION DOC]
        # Build a new 1-D object ndarray of length size where each element is a bytes
        # object created from the corresponding C string (copy, not a view). Marks
        # external_view_exists and sets capacity = size (the buffer itself is not
        # shrunk,
        # so capacity then understates the allocation).
        # Outputs: object ndarray of bytes.
        cdef:
            ndarray ao
            Py_ssize_t n
            object val

        ao = np.empty(self.data.size, dtype=object)
        for i in range(self.data.size):
            val = self.data.data[i]
            ao[i] = val
        self.external_view_exists = True
        self.data.capacity = self.data.size
        return ao

    cdef void append(self, char *x) noexcept:
        # [FUNCTION DOC]
        # Append a C string pointer, growing the buffer (resize) when full. Does not
        # check external_view_exists. Inputs: x - char pointer (borrowed).
        # Side effects: mutates the buffer; may reallocate (leaking, see resize).

        if needs_resize(self.data.size, self.data.capacity):
            self.resize(self.data.capacity * 4)

        append_data_string(&self.data, x)

    cdef extend(self, ndarray[object] x):
        # [FUNCTION DOC]
        # Append every element of the object array x, each converted to a char pointer
        # (elements must be bytes-like; conversion errors are raised by the cast).
        # Side effects: mutates the buffer.
        for i in range(len(x)):
            self.append(x[i])


cdef class ObjectVector(Vector):
    # [CLASS DOC]
    # Growable array of Python object references backed by an object ndarray ao.
    # Fields: data - raw pointer into ao's buffer; size, capacity - element counts.
    # Holds a strong reference to every appended object (via the ndarray). Used to
    # collect uniques by PyObjectHashTable, StringHashTable and ObjectFactorizer.

    cdef:
        PyObject **data
        Py_ssize_t size, capacity
        ndarray ao

    def __cinit__(self):
        # [FUNCTION DOC]
        # Allocate an object ndarray of capacity 128 (filled with None) and point data
        # at its buffer; size = 0.
        self.size = 0
        self.capacity = _INIT_VEC_CAP
        self.ao = np.empty(_INIT_VEC_CAP, dtype=object)
        self.data = <PyObject**>self.ao.data

    def __len__(self) -> int:
        # [FUNCTION DOC]
        # Return the number of stored objects (size).
        return self.size

    cdef append(self, object obj):
        # [FUNCTION DOC]
        # Append obj. When full, capacity becomes max(2 * capacity, 128) and the
        # ndarray is resized in place (refcheck disabled). The reference count of obj is
        # incremented and the pointer stored in the next slot.
        # Exceptions: ValueError if growth is needed while an external view exists.
        # Side effects: mutates the buffer; new reference to obj owned by the array.
        if self.size == self.capacity:
            if self.external_view_exists:
                raise ValueError("external reference but "
                                 "Vector.resize() needed")
            self.capacity = max(self.capacity * 2, _INIT_VEC_CAP)
            self.ao.resize(self.capacity, refcheck=False)
            self.data = <PyObject**>self.ao.data

        Py_INCREF(obj)
        self.data[self.size] = <PyObject*>obj
        self.size += 1

    cpdef ndarray[object, ndim=1] to_array(self):
        # [FUNCTION DOC]
        # Return the internal object ndarray (no copy), shrinking it to size first if
        # needed; marks external_view_exists = True.
        # Exceptions: ValueError if shrinking is needed while a view already exists.
        if self.capacity != self.size:
            if self.external_view_exists:
                raise ValueError("should have raised on append()")
            self.ao.resize(self.size, refcheck=False)
            self.capacity = self.size
        self.external_view_exists = True
        return self.ao

    cdef extend(self, ndarray[object] x):
        # [FUNCTION DOC]
        # Append every element of the object array x in order (via append).
        # Exceptions: as append. Side effects: mutates the buffer.
        for i in range(len(x)):
            self.append(x[i])

