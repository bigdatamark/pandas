# [MODULE DOC]
# Tempita template generating the typed containers and hash table classes of
# pandas._libs.hashtable (included by hashtable.pyx; .pxi output is generated).
# Contents:
# - to_khcomplex64_t/to_khcomplex128_t: convert numpy complex scalars to khash
#   complex key structs.
# - is_nan_<c_type> / are_equivalent_<c_type>: NaN test and key equality per key
#   C type (floats/complex use NaN-aware equality cimported from khash.pxd).
# - <Name>VectorData structs, append_data_<dtype> and needs_resize: raw growable
#   buffers (pointer, size, capacity) usable without the GIL.
# - Vector classes (<Name>Vector per numeric dtype, StringVector, ObjectVector):
#   amortised-growth arrays that can hand their buffer out as an ndarray once
#   (external_view_exists), after which further growth raises ValueError.
# - <Name>HashTable per numeric dtype: khash map key -> position, with optional
#   mask-based NA handling (single na_position slot); unique/factorize/lookup/
#   map_locations/hash_inner_join algorithms.
# - <Name>Factorizer: stateful factorizers built on the tables.
# - StringHashTable (str keys via UTF-8 pointers) and PyObjectHashTable
#   (arbitrary hashable objects, NaN-aware).
# Substituted types: numeric dtypes complex128, complex64, float64, float32,
# int64/32/16/8, uint64/32/16/8 (and 'string'/char pointer for VectorData).
"""
Template for each `dtype` helper function for hashtable

WARNING: DO NOT edit .pxi FILE directly, .pxi is generated from .pxi.in
"""
from cpython.unicode cimport PyUnicode_AsUTF8

{{py:

# name
complex_types = ['complex64',
                 'complex128']
}}

{{for name in complex_types}}
cdef kh{{name}}_t to_kh{{name}}_t({{name}}_t val) noexcept nogil:
    # [FUNCTION DOC]
    # HELPER: Template (name = complex64 or complex128). Copy the real and imaginary
    # parts of a numpy complex value into a khash complex key struct of matching
    # precision. Inputs: val - complex scalar. Outputs: the struct. No exceptions;
    # nogil; no side effects.
    cdef kh{{name}}_t res
    res.real = val.real
    res.imag = val.imag
    return res

{{endfor}}


{{py:


# name
c_types = ['khcomplex128_t',
           'khcomplex64_t',
           'float64_t',
           'float32_t',
           'int64_t',
           'int32_t',
           'int16_t',
           'int8_t',
           'uint64_t',
           'uint32_t',
           'uint16_t',
           'uint8_t']
}}

{{for c_type in c_types}}

cdef bint is_nan_{{c_type}}({{c_type}} val) noexcept nogil:
    # [FUNCTION DOC]
    # HELPER: Template over key C types (khcomplex128/64, float64/32, int and uint
    # 8..64). Return true if val is NaN: for complex, if either component is NaN; for
    # floats, if val differs from itself; for integer types always false.
    # nogil; no side effects.
    {{if c_type in {'khcomplex128_t', 'khcomplex64_t'} }}
    return val.real != val.real or val.imag != val.imag
    {{elif c_type in {'float64_t', 'float32_t'} }}
    return val != val
    {{else}}
    return False
    {{endif}}


{{if c_type in {'khcomplex128_t', 'khcomplex64_t', 'float64_t', 'float32_t'} }}
# are_equivalent_{{c_type}} is cimported via khash.pxd
{{else}}
cdef bint are_equivalent_{{c_type}}({{c_type}} val1, {{c_type}} val2) noexcept nogil:
    # [FUNCTION DOC]
    # HELPER: Template, generated only for integer key types (the float/complex
    # versions come from khash.pxd). Return true if the two values are equal.
    # nogil; no side effects.
    return val1 == val2
{{endif}}

{{endfor}}


