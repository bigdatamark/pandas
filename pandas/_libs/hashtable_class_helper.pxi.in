    @cython.boundscheck(False)
    @cython.wraparound(False)
    def _unique(self, ndarray[object] values, ObjectVector uniques,
                Py_ssize_t count_prior=0, Py_ssize_t na_sentinel=-1,
                object na_value=None, bint ignore_na=False,
                bint return_inverse=False):
        # [FUNCTION DOC]
        # Core uniques/factorize routine for strings. First pass (with the GIL): if
        # ignore_na, elements that are not str, or that match na_value (== for non-null
        # na_value, is_matching_na for null-like na_value), get label na_sentinel;
        # others are converted to UTF-8 pointers (repr is used on UnicodeEncodeError).
        # Second pass (nogil): elements whose label equals na_sentinel are skipped when
        # ignore_na; new keys are inserted, their index recorded, and labels assigned
        # from count_prior on. Finally uniques receives the original objects at the
        # first-occurrence indices.
        # Inputs: values - object ndarray; uniques - ObjectVector (mutated);
        # count_prior; na_sentinel; na_value; ignore_na; return_inverse.
        # Outputs: uniques ndarray, plus labels intp ndarray if return_inverse.
        # Exceptions: MemoryError; TypeError for non-str elements when ignore_na is
        # false.
        # KNOWN ISSUE: the comment says NaN/None are stringified when ignore_na is
        # false, but the unchecked str cast makes PyUnicode_AsUTF8 raise TypeError for
        # non-str values (and the malloc'ed pointer buffer leaks).
        # KNOWN ISSUE: labels starts as zeros and the skip test is "label equals
        # na_sentinel", so with na_sentinel == 0 every element is skipped and uniques
        # come back empty with all labels 0 (verified). Also, ignore_na with
        # return_inverse false would write to an unallocated labels buffer.
        """
        Calculate unique values and labels (no sorting!)

        Parameters
        ----------
        values : ndarray[object]
            Array of values of which unique will be calculated
        uniques : ObjectVector
            Vector into which uniques will be written
        count_prior : Py_ssize_t, default 0
            Number of existing entries in uniques
        na_sentinel : Py_ssize_t, default -1
            Sentinel value used for all NA-values in inverse
        na_value : object, default None
            Value to identify as missing. If na_value is None, then any value
            that is not a string is considered missing. If na_value is
            not None, then _additionally_ any value "val" satisfying
            val == na_value is considered missing.
        ignore_na : bool, default False
            Whether NA-values should be ignored for calculating the uniques. If
            True, the labels corresponding to missing values will be set to
            na_sentinel.
        return_inverse : bool, default False
            Whether the mapping of the original array values to their location
            in the vector of uniques should be returned.

        Returns
        -------
        uniques : ndarray[object]
            Unique values of input, not sorted
        labels : ndarray[intp_t] (if return_inverse=True)
            The labels from values to uniques
        """
        cdef:
            Py_ssize_t i, idx, count = count_prior, n = len(values)
            intp_t[::1] labels
            int64_t[::1] uindexer
            int ret = 0
            object val
            const char *v
            const char **vecs
            khiter_t k
            bint use_na_value
            bint non_null_na_value

        if return_inverse:
            labels = np.zeros(n, dtype=np.intp)
        uindexer = np.empty(n, dtype=np.int64)
        use_na_value = na_value is not None
        non_null_na_value = not checknull(na_value)

        # assign pointers and pre-filter out missing (if ignore_na)
        vecs = <const char **>malloc(n * sizeof(char *))
        if vecs is NULL:
            raise MemoryError()
        for i in range(n):
            val = values[i]

            if (ignore_na
                and (not isinstance(val, str)
                     or (use_na_value and (
                        (non_null_na_value and val == na_value) or
                        (not non_null_na_value and is_matching_na(val, na_value)))
                        )
                    )
                ):
                # if missing values do not count as unique values (i.e. if
                # ignore_na is True), we can skip the actual value, and
                # replace the label with na_sentinel directly
                labels[i] = na_sentinel
            else:
                # if ignore_na is False, we also stringify NaN/None/etc.
                try:
                    v = PyUnicode_AsUTF8(<str>val)
                except UnicodeEncodeError:
                    v = PyUnicode_AsUTF8(<str>repr(val))
                vecs[i] = v

        # compute
        with nogil:
            for i in range(n):
                if ignore_na and labels[i] == na_sentinel:
                    # skip entries for ignored missing values (see above)
                    continue

                v = vecs[i]
                k = kh_get_str(self.table, v)
                if k == self.table.n_buckets:
                    # k hasn't been seen yet
                    k = kh_put_str(self.table, v, &ret)
                    uindexer[count] = i
                    if return_inverse:
                        self.table.vals[k] = count
                        labels[i] = count
                    count += 1
                elif return_inverse:
                    # k falls into a previous bucket
                    # only relevant in case we need to construct the inverse
                    idx = self.table.vals[k]
                    labels[i] = idx

        free(vecs)

        # uniques
        for i in range(count):
            uniques.append(values[uindexer[i]])

        if return_inverse:
            return uniques.to_array(), labels.base  # .base -> underlying ndarray
        return uniques.to_array()

    def unique(self, ndarray[object] values, *, bint return_inverse=False, object mask=None):
        # [FUNCTION DOC]
        # Return unique strings in first-appearance order (ignore_na False), optionally
        # with labels. mask is accepted but ignored. Exceptions: TypeError if any value
        # is not a str (see _unique).
        """
        Calculate unique values and labels (no sorting!)

        Parameters
        ----------
        values : ndarray[object]
            Array of values of which unique will be calculated
        return_inverse : bool, default False
            Whether the mapping of the original array values to their location
            in the vector of uniques should be returned.
        mask : ndarray[bool], optional
            Not yet implemented for StringHashTable

        Returns
        -------
        uniques : ndarray[object]
            Unique values of input, not sorted
        labels : ndarray[intp_t] (if return_inverse)
            The labels from values to uniques
        """
        uniques = ObjectVector()
        return self._unique(values, uniques, ignore_na=False,
                            return_inverse=return_inverse)

    def factorize(self, ndarray[object] values, Py_ssize_t na_sentinel=-1,
                  object na_value=None, object mask=None, ignore_na=True):
        # [FUNCTION DOC]
        # Factorize with a fresh ObjectVector; non-str values and na_value matches get
        # na_sentinel when ignore_na (default). mask ignored.
        # Outputs: tuple (uniques object ndarray, labels intp ndarray).
        """
        Calculate unique values and labels (no sorting!)

        Missing values are not included in the "uniques" for this method.
        The labels for any missing values will be set to "na_sentinel"

        Parameters
        ----------
        values : ndarray[object]
            Array of values of which unique will be calculated
        na_sentinel : Py_ssize_t, default -1
            Sentinel value used for all NA-values in inverse
        na_value : object, default None
            Value to identify as missing. If na_value is None, then any value
            that is not a string is considered missing. If na_value is
            not None, then _additionally_ any value "val" satisfying
            val == na_value is considered missing.
        mask : ndarray[bool], optional
            Not yet implemented for StringHashTable.

        Returns
        -------
        uniques : ndarray[object]
            Unique values of input, not sorted
        labels : ndarray[intp]
            The labels from values to uniques
        """
        uniques_vector = ObjectVector()
        return self._unique(values, uniques_vector, na_sentinel=na_sentinel,
                            na_value=na_value, ignore_na=ignore_na,
                            return_inverse=True)

    # Add unused mask parameter for compat with other signatures
    def get_labels(self, ndarray[object] values, ObjectVector uniques,
                   Py_ssize_t count_prior=0, Py_ssize_t na_sentinel=-1,
                   object na_value=None, object mask=None):
        # [FUNCTION DOC]
        # Factorize into the given uniques vector, numbering from count_prior, with
        # missing values labelled na_sentinel. mask is ignored (signature compat).
        # Outputs: labels intp ndarray. Side effects: mutates the table and uniques.
        # -> np.ndarray[np.intp]
        _, labels = self._unique(values, uniques, count_prior=count_prior,
                                 na_sentinel=na_sentinel, na_value=na_value,
                                 ignore_na=True, return_inverse=True)
        return labels


cdef class PyObjectHashTable(HashTable):
    # [CLASS DOC]
    # Hash table from arbitrary hashable Python objects to positions, using pandas
    # NaN-aware hashing/equality (kh_python_hash_func / kh_python_hash_equal). Keys
    # are stored as borrowed pointers (no reference counting), so the objects must
    # be kept alive elsewhere (e.g. by the values array or uniques vector).

    def __init__(self, int64_t size_hint=1):
        # [FUNCTION DOC]
        # Create the khash pymap presized for size_hint (capped at SIZE_HINT_LIMIT).
        # Side effects: allocates memory.
        self.table = kh_init_pymap()
        size_hint = min(kh_needed_n_buckets(size_hint), SIZE_HINT_LIMIT)
        kh_resize_pymap(self.table, size_hint)

    def __dealloc__(self):
        # [FUNCTION DOC]
        # Destroy the khash table (if allocated) and null the pointer.
        if self.table is not NULL:
            kh_destroy_pymap(self.table)
            self.table = NULL

    def __len__(self) -> int:
        # [FUNCTION DOC]
        # Return the number of keys stored.
        return self.table.size

    def __contains__(self, object key) -> bool:
        # [FUNCTION DOC]
        # Membership test. Calls hash(key) first so unhashable keys raise TypeError
        # (the khash hash function itself swallows errors). Outputs: bool.
        cdef:
            khiter_t k
        hash(key)

        k = kh_get_pymap(self.table, <PyObject*>key)
        return k != self.table.n_buckets

    def sizeof(self, deep: bool = False) -> int:
        # [FUNCTION DOC]
        # Estimate memory use in bytes: overhead + flag words + n_buckets times
        # (pointer size + value size). deep is ignored.
        """ return the size of my table in bytes """
        overhead = 4 * sizeof(uint32_t) + 3 * sizeof(uint32_t*)
        for_flags = max(1, self.table.n_buckets >> 5) * sizeof(uint32_t)
        for_pairs =  self.table.n_buckets * (sizeof(PyObject *) +  # keys
                                             sizeof(Py_ssize_t))   # vals
        return overhead + for_flags + for_pairs

    def get_state(self) -> dict[str, int]:
        # [FUNCTION DOC]
        # Return a dict with the khash fields n_buckets, size, n_occupied, upper_bound.
        """
        returns infos about the current state of the hashtable like size,
        number of buckets and so on.
        """
        return {
            'n_buckets' : self.table.n_buckets,
            'size' : self.table.size,
            'n_occupied' : self.table.n_occupied,
            'upper_bound' : self.table.upper_bound,
        }

    cpdef get_item(self, object val):
        # [FUNCTION DOC]
        # Return the position stored for val. Exceptions: KeyError(val) if absent
        # (unhashable val silently hashes to 0 and is normally reported as KeyError).
        cdef:
            khiter_t k

        k = kh_get_pymap(self.table, <PyObject*>val)
        if k != self.table.n_buckets:
            return self.table.vals[k]
        else:
            raise KeyError(val)

    cpdef set_item(self, object key, Py_ssize_t val):
        # [FUNCTION DOC]
        # Insert key and set its position to val. hash(key) is called first so
        # unhashable keys raise TypeError. The else-branch KeyError is unreachable.
        # Side effects: mutates the table; key is borrowed (no reference kept).
        cdef:
            khiter_t k
            int ret = 0
            char* buf

        hash(key)

        k = kh_put_pymap(self.table, <PyObject*>key, &ret)
        if kh_exist_pymap(self.table, k):
            self.table.vals[k] = val
        else:
            raise KeyError(key)

    def map_locations(self, ndarray[object] values, object mask = None) -> None:
        # [FUNCTION DOC]
        # Insert each element of values with its index as value (last duplicate wins).
        # mask is ignored. Exceptions: TypeError for unhashable elements.
        # Side effects: mutates the table; keys borrowed from values.
        # mask not yet implemented
        cdef:
            Py_ssize_t i, n = len(values)
            int ret = 0
            object val
            khiter_t k

        for i in range(n):
            val = values[i]
            hash(val)

            k = kh_put_pymap(self.table, <PyObject*>val, &ret)
            self.table.vals[k] = i

    def lookup(self, ndarray[object] values, object mask = None) -> ndarray:
        # [FUNCTION DOC]
        # Return an intp array with each element's stored position or -1 if absent.
        # mask is ignored. Exceptions: TypeError for unhashable elements.
        # -> np.ndarray[np.intp]
        # mask not yet implemented
        cdef:
            Py_ssize_t i, n = len(values)
            int ret = 0
            object val
            khiter_t k
            intp_t[::1] locs = np.empty(n, dtype=np.intp)

        for i in range(n):
            val = values[i]
            hash(val)

            k = kh_get_pymap(self.table, <PyObject*>val)
            if k != self.table.n_buckets:
                locs[i] = self.table.vals[k]
            else:
                locs[i] = -1

        return np.asarray(locs)

    @cython.boundscheck(False)
    @cython.wraparound(False)
    def _unique(self, ndarray[object] values, ObjectVector uniques,
                Py_ssize_t count_prior=0, Py_ssize_t na_sentinel=-1,
                object na_value=None, bint ignore_na=False,
                bint return_inverse=False):
        # [FUNCTION DOC]
        # Core uniques/factorize routine for objects (holds the GIL throughout). For
        # each element: hash() it (TypeError if unhashable); if ignore_na and the value
