# [MODULE DOC]
# Tempita template (rendered to algos_take_helper.pxi and included into algos.pyx)
#   generating typed 'take' kernels: gather elements of a 1-D or 2-D array by an integer
#   indexer into a preallocated output array, writing a fill value wherever the indexer
#   is -1. Used by pandas.core.array_algos.take.
# One variant of each kernel is generated per (input type, output type) pair listed in
#   'dtypes', e.g. int8->int8/int32/int64/float64, bool (uint8)->bool or object,
#   float32->float32/float64, object->object. Generated names are take_1d_<name>_<dest>,
#   take_2d_axis0_..., take_2d_axis1_... and take_2d_multi_..., where name/dest drop the
#   '_t' suffix and uint8 is called 'bool'. For uint8 input with object output, values
#   are converted to Python True/False (value > 0). Do not edit the generated .pxi.
"""
Template for each `dtype` helper function for take

WARNING: DO NOT edit .pxi FILE directly, .pxi is generated from .pxi.in
"""

# ----------------------------------------------------------------------
# take_1d, take_2d
# ----------------------------------------------------------------------


{{py:

# c_type_in, c_type_out
dtypes = [
    ('uint8_t', 'uint8_t'),
    ('uint8_t', 'object'),
    ('uint16_t', 'uint16_t'),
    ('uint32_t', 'uint32_t'),
    ('uint64_t', 'uint64_t'),
    ('int8_t', 'int8_t'),
    ('int8_t', 'int32_t'),
    ('int8_t', 'int64_t'),
    ('int8_t', 'float64_t'),
    ('int16_t', 'int16_t'),
    ('int16_t', 'int32_t'),
    ('int16_t', 'int64_t'),
    ('int16_t', 'float64_t'),
    ('int32_t', 'int32_t'),
    ('int32_t', 'int64_t'),
    ('int32_t', 'float64_t'),
    ('int64_t', 'int64_t'),
    ('int64_t', 'float64_t'),
    ('float32_t', 'float32_t'),
    ('float32_t', 'float64_t'),
    ('float64_t', 'float64_t'),
    ('object', 'object'),
]


def get_dispatch(dtypes):

    for (c_type_in, c_type_out) in dtypes:

        def get_name(dtype_name):
            if dtype_name == "object":
                return "object"
            if dtype_name == "uint8_t":
                return "bool"
            return dtype_name[:-2]

        name = get_name(c_type_in)
        dest = get_name(c_type_out)

        args = dict(name=name, dest=dest, c_type_in=c_type_in,
                    c_type_out=c_type_out)

        yield (name, dest, c_type_in, c_type_out)

}}


{{for name, dest, c_type_in, c_type_out in get_dispatch(dtypes)}}


@cython.wraparound(False)
@cython.boundscheck(False)
{{if c_type_in != "object"}}
def take_1d_{{name}}_{{dest}}(const {{c_type_in}}[:] values,
{{else}}
def take_1d_{{name}}_{{dest}}(ndarray[{{c_type_in}}, ndim=1] values,
{{endif}}
                              const intp_t[:] indexer,
                              {{c_type_out}}[:] out,
                              fill_value=np.nan):
    # [FUNCTION DOC]
    # Template: out[i] = values[indexer[i]] for each i, or fill_value where indexer[i]
    #   == -1. Generated for every (c_type_in, c_type_out) pair.
    # Inputs: values - 1-D array of c_type_in (read-only memoryview, or ndarray for
    #   object); indexer - 1-D intp array of positions into values or -1; out -
    #   preallocated 1-D c_type_out array of len(indexer); fill_value - scalar converted
    #   to c_type_out (default NaN).
    # Outputs: None; results written to out.
    # Exceptions: TypeError/OverflowError if fill_value cannot be converted to
    #   c_type_out (e.g. NaN into an integer output). No bounds checking: other negative
    #   or too large indexer values are undefined behaviour.
    # Side effects: mutates out; releases the GIL during the loop unless the output type
    #   is object.

    cdef:
        Py_ssize_t i, n, idx
        {{c_type_out}} fv

    n = indexer.shape[0]

    fv = fill_value

    {{if c_type_out != "object"}}
    with nogil:
    {{else}}
    if True:
    {{endif}}
        for i in range(n):
            idx = indexer[i]
            if idx == -1:
                out[i] = fv
            else:
                {{if c_type_in == "uint8_t" and c_type_out == "object"}}
                out[i] = True if values[idx] > 0 else False
                {{else}}
                out[i] = values[idx]
                {{endif}}


@cython.wraparound(False)
@cython.boundscheck(False)
{{if c_type_in != "object"}}
def take_2d_axis0_{{name}}_{{dest}}(const {{c_type_in}}[:, :] values,
{{else}}
def take_2d_axis0_{{name}}_{{dest}}(ndarray[{{c_type_in}}, ndim=2] values,
{{endif}}
                                    ndarray[intp_t, ndim=1] indexer,
                                    {{c_type_out}}[:, :] out,
                                    fill_value=np.nan):
    # [FUNCTION DOC]
    # Template: take rows - out[i, :] = values[indexer[i], :], or a row of fill_value
    #   where indexer[i] == -1.
    # Inputs: values - 2-D c_type_in array (n_rows_in, k); indexer - 1-D intp ndarray of
    #   length n; out - preallocated 2-D c_type_out array (n, k); fill_value - scalar
    #   converted to c_type_out (default NaN).
    # Outputs: None; results written to out.
    # Exceptions: conversion errors for fill_value; indices are not bounds checked.
    # Side effects: mutates out. When input and output types match and are not object,
    #   runs without the GIL, and if both arrays are contiguous along axis 1 with
    #   matching strides and a row of n elements spans >= 256 bytes, copies whole rows
    #   with memmove (GH#3130); otherwise copies element by element.
    # KNOWN ISSUE: the memmove fast-path size test uses sizeof(type) * n (number of
    #   output rows) rather than the row length k, so the heuristic does not measure the
    #   per-row copy size; results are still correct.
    cdef:
        Py_ssize_t i, j, k, n, idx
        {{c_type_out}} fv
        {{if c_type_in == c_type_out != "object"}}
        const {{c_type_out}} *v
        {{c_type_out}} *o
        {{endif}}

    n = len(indexer)
    k = values.shape[1]

    fv = fill_value

    {{if c_type_in == c_type_out != "object"}}
    # GH#3130
    with nogil:
        if (values.strides[1] == out.strides[1] and
            values.strides[1] == sizeof({{c_type_out}}) and
            sizeof({{c_type_out}}) * n >= 256):

            for i in range(n):
                idx = indexer[i]
                if idx == -1:
                    for j in range(k):
                        out[i, j] = fv
                else:
                    v = &values[idx, 0]
                    o = &out[i, 0]
                    memmove(o, v, <size_t>(sizeof({{c_type_out}}) * k))
        else:
            for i in range(n):
                idx = indexer[i]
                if idx == -1:
                    for j in range(k):
                        out[i, j] = fv
                else:
                    for j in range(k):
                        out[i, j] = values[idx, j]
    {{else}}

    for i in range(n):
        idx = indexer[i]
        if idx == -1:
            for j in range(k):
                out[i, j] = fv
        else:
            for j in range(k):
                {{if c_type_in == "uint8_t" and c_type_out == "object"}}
                out[i, j] = True if values[idx, j] > 0 else False
                {{else}}
                out[i, j] = values[idx, j]
                {{endif}}
    {{endif}}


@cython.wraparound(False)
@cython.boundscheck(False)
{{if c_type_in != "object"}}
def take_2d_axis1_{{name}}_{{dest}}(const {{c_type_in}}[:, :] values,
{{else}}
def take_2d_axis1_{{name}}_{{dest}}(ndarray[{{c_type_in}}, ndim=2] values,
{{endif}}
                                    ndarray[intp_t, ndim=1] indexer,
                                    {{c_type_out}}[:, :] out,
                                    fill_value=np.nan):
    # [FUNCTION DOC]
    # Template: take columns - out[i, j] = values[i, indexer[j]], or fill_value where
    #   indexer[j] == -1.
    # Inputs: values - 2-D c_type_in array (n, k_in); indexer - 1-D intp ndarray of
    #   length k; out - preallocated 2-D c_type_out array (n, k); fill_value - scalar
    #   converted to c_type_out (default NaN).
    # Outputs: None; returns immediately when n == 0 or k == 0 (before fill_value is
    #   converted).
    # Exceptions: conversion errors for fill_value; no bounds checking.
    # Side effects: mutates out; releases the GIL when input and output types are equal
    #   and not object.

    cdef:
        Py_ssize_t i, j, k, n, idx
        {{c_type_out}} fv

    n = len(values)
    k = len(indexer)

    if n == 0 or k == 0:
        return

    fv = fill_value

    {{if c_type_in == c_type_out != "object"}}
    with nogil:
        for i in range(n):
            for j in range(k):
                idx = indexer[j]
                if idx == -1:
                    out[i, j] = fv
                else:
                    out[i, j] = values[i, idx]

    {{else}}
    for i in range(n):
        for j in range(k):
            idx = indexer[j]
            if idx == -1:
                out[i, j] = fv
            else:
                {{if c_type_in == "uint8_t" and c_type_out == "object"}}
                out[i, j] = True if values[i, idx] > 0 else False
                {{else}}
                out[i, j] = values[i, idx]
                {{endif}}
    {{endif}}


@cython.wraparound(False)
@cython.boundscheck(False)
def take_2d_multi_{{name}}_{{dest}}(ndarray[{{c_type_in}}, ndim=2] values,
                                    indexer,
                                    ndarray[{{c_type_out}}, ndim=2] out,
                                    fill_value=np.nan):
    # [FUNCTION DOC]
    # Template: take along both axes - out[i, j] = values[idx0[i], idx1[j]], where
    #   (idx0, idx1) = indexer; fill_value is written if either index is -1.
    # Inputs: values - 2-D c_type_in ndarray; indexer - pair (tuple/list) of 1-D intp
    #   ndarrays (row indexer, column indexer); out - preallocated 2-D c_type_out
    #   ndarray of shape (len(idx0), len(idx1)); fill_value - scalar (default NaN).
    # Outputs: None; results written to out.
    # Exceptions: conversion errors for fill_value or indexer elements; no bounds
    #   checking.
    # Side effects: mutates out; holds the GIL throughout.
    cdef:
        Py_ssize_t i, j, k, n, idx
        ndarray[intp_t, ndim=1] idx0 = indexer[0]
        ndarray[intp_t, ndim=1] idx1 = indexer[1]
        {{c_type_out}} fv

    n = len(idx0)
    k = len(idx1)

    fv = fill_value
    for i in range(n):
        idx = idx0[i]
        if idx == -1:
            for j in range(k):
                out[i, j] = fv
        else:
            for j in range(k):
                if idx1[j] == -1:
                    out[i, j] = fv
                else:
                    {{if c_type_in == "uint8_t" and c_type_out == "object"}}
                    out[i, j] = True if values[idx, idx1[j]] > 0 else False
                    {{else}}
                    out[i, j] = values[idx, idx1[j]]
                    {{endif}}

{{endfor}}
