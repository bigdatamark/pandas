# [MODULE DOC]
# Tempita template (rendered to algos_common_helper.pxi and included into algos.pyx)
#   generating the ensure_<dtype> family: cheap conversions of arbitrary inputs to
#   ndarrays of a specific dtype, returning the input unchanged when it already has that
#   dtype. Generated for float64, int8, int16, int32, int64 and uint64 (float32, small
#   unsigned and complex are disabled to reduce wheel size), plus the hand-written
#   ensure_platform_int and ensure_object. Do not edit the generated .pxi.
"""
Template for each `dtype` helper function using 1-d template

WARNING: DO NOT edit .pxi FILE directly, .pxi is generated from .pxi.in
"""

# ----------------------------------------------------------------------
# ensure_dtype
# ----------------------------------------------------------------------


def ensure_platform_int(object arr):
    # [FUNCTION DOC]
    # Return arr as an ndarray of the platform pointer-sized integer (np.intp).
    # Inputs: arr - any object; ndarrays are checked by numpy type number.
    # Outputs: arr itself if it is already an intp ndarray; otherwise a newly cast intp
    #   ndarray (C-level cast, may wrap/truncate like astype); non-arrays are converted
    #   with np.array(arr, dtype=intp) (always copies).
    # Exceptions: whatever numpy raises for unconvertible input (TypeError / ValueError
    #   / OverflowError).
    # Side effects: allocation when a conversion is needed.
    # GH3033, GH1392
    # platform int is the size of the int pointer, e.g. np.intp
    if util.is_array(arr):
        if (<ndarray>arr).descr.type_num == cnp.NPY_INTP:
            return arr
        else:
            # equiv: arr.astype(np.intp)
            return cnp.PyArray_Cast(<ndarray>arr, cnp.NPY_INTP)
    else:
        return np.array(arr, dtype=np.intp)


def ensure_object(object arr):
    # [FUNCTION DOC]
    # Return arr as an object-dtype ndarray.
    # Inputs: arr - any object.
    # Outputs: arr itself if already an object ndarray; otherwise a cast copy for
    #   ndarrays, or np.array(arr, dtype=object) for other inputs.
    # Exceptions: those raised by numpy conversion.
    # Side effects: allocation when converting.
    if util.is_array(arr):
        if (<ndarray>arr).descr.type_num == NPY_OBJECT:
            return arr
        else:
            # equiv: arr.astype(object)
            return cnp.PyArray_Cast(<ndarray>arr, NPY_OBJECT)
    else:
        return np.array(arr, dtype=np.object_)

{{py:

# name, c_type, dtype
dtypes = [('float64', 'FLOAT64', 'float64'),
          # ('float32', 'FLOAT32', 'float32'),  # disabling bc unused
          ('int8', 'INT8', 'int8'),
          ('int16', 'INT16', 'int16'),
          ('int32', 'INT32', 'int32'),
          ('int64', 'INT64', 'int64'),
          ('uint64', 'UINT64', 'uint64'),
          # Disabling uint and complex dtypes because we do not use them
          #  (and compiling them increases wheel size) (except uint64)
          # ('uint8', 'UINT8', 'uint8'),
          # ('uint16', 'UINT16', 'uint16'),
          # ('uint32', 'UINT32', 'uint32'),
          # ('complex64', 'COMPLEX64', 'complex64'),
          # ('complex128', 'COMPLEX128', 'complex128')
]

def get_dispatch(dtypes):

    for name, c_type, dtype in dtypes:
        yield name, c_type, dtype
}}

{{for name, c_type, dtype in get_dispatch(dtypes)}}


def ensure_{{name}}(object arr):
    # [FUNCTION DOC]
    # Template ensure_<name> for name in float64, int8, int16, int32, int64, uint64
    #   (c_type is the upper-case NPY type code, dtype the numpy dtype name). Return arr
    #   as an ndarray of that dtype.
    # Inputs: arr - any object.
    # Outputs: arr itself if it is an ndarray whose numpy type number already matches;
    #   otherwise a cast copy for ndarrays (unsafe C-level cast, like astype), or
    #   np.asarray(arr, dtype) for non-arrays (no copy when possible).
    # Exceptions: those raised by numpy conversion (e.g. ValueError for strings).
    # Side effects: allocation when converting.
    if util.is_array(arr):
        if (<ndarray>arr).descr.type_num == NPY_{{c_type}}:
            return arr
        else:
            # equiv: arr.astype(np.{{dtype}})
            return cnp.PyArray_Cast(<ndarray>arr, cnp.NPY_{{c_type}})
    else:
        return np.asarray(arr, dtype=np.{{dtype}})

{{endfor}}
