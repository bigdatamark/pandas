# [MODULE DOC]
# Meson configure_file template producing free_threading_config.pxi: defines the
# Cython compile-time constant CYTHON_COMPATIBLE_WITH_FREE_THREADING, substituted
# at build time with the build's freethreading_compatible setting (true/false).
# Modules include the generated file to decide whether to declare themselves safe
# for free-threaded (no-GIL) CPython builds. No runtime code or side effects.
# Autogenerated file containing Cython compile-time defines

DEF CYTHON_COMPATIBLE_WITH_FREE_THREADING = @freethreading_compatible@
